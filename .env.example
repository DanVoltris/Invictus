# Copy this file to ".env" and fill in your Stripe TEST keys.
# Get them at https://dashboard.stripe.com/test/apikeys  (toggle "Test mode" ON).
#
# IMPORTANT: use TEST keys here (they start with sk_test_ / rk_test_ / pk_test_). Live keys work too
# — production uses them, set in Vercel — but they charge real cards, so never on your laptop.
# Prefer a RESTRICTED key (rk_test_) — but read the next paragraph before you scope it.
#
# ⚠ REFUNDS NEED TWO MORE PERMISSIONS, AND THE ERROR DOES NOT SAY SO.
# This app can refund a booking (manager portal, and customer self-cancellation inside the
# 24-hour window — api/booking-series.js ?action=refund and api/booking.js). A restricted key
# scoped only to "Checkout Sessions" answers POST /v1/refunds with an HTTP 403 whose message is
# about permissions and reads exactly like a bug in this code. It is not. Grant, on the key:
#
#     Refunds ......... write     (create the refund)
#     Charges ......... read      (Stripe resolves the PaymentIntent's charge to refund it)
#
# Set them in Dashboard → Developers → API keys → (your restricted key) → Edit. Everything else
# the app does — Checkout Sessions, PaymentIntents, Customers, SetupIntents, Payment Methods —
# is unchanged. A full secret key (sk_test_) already has all of this and needs nothing done.
# When the key IS wrong, the API says so by name rather than returning a generic failure: look
# for "Refunds: write, Charges: read" in the error, and for `code: "stripe_key_permission"`.
# Nothing is recorded as refunded when that happens, so fixing the key and retrying is safe.
#
# Put real keys only in ".env" (which is gitignored) — NOT in this .env.example file.
STRIPE_SECRET_KEY=rk_test_xxx_or_sk_test_xxx

# Publishable key (starts with pk_test_). Safe to expose in the browser.
STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Optional locally, REQUIRED in production: webhook signing secret (starts with whsec_).
# Only needed if you run `stripe listen` to test webhooks locally. Leave blank otherwise.
# Subscribe the endpoint to `payment_intent.succeeded` AND `charge.refunded` — the second is how a
# refund issued from the Stripe dashboard gets written into public.refunds, and how a refund this
# app issued settles from 'pending' to 'succeeded'. Without it the dashboard and the database
# disagree about what has been paid back, and the same booking can be refunded twice.
#   stripe listen --events payment_intent.succeeded,charge.refunded --forward-to localhost:4242/api/webhook
STRIPE_WEBHOOK_SECRET=

# Port the local server runs on.
PORT=4242

# ── Supabase (manager portal: database + email/password auth) ──────────────
# Create a free project at https://supabase.com → then Project Settings → API.
# URL and ANON key are safe in the browser; SERVICE_ROLE key is SECRET (server only).
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...            # public (used by the manager login page)
SUPABASE_SERVICE_ROLE_KEY=eyJ...    # SECRET — server only, never commit / never expose


# ── Notifications (email + SMS outbox — see lib/notify.js) ─────────────────
# ALL OPTIONAL. With none of these set the app behaves exactly as it always has: it queues
# nothing it cannot deliver, logs what it WOULD have sent, and never fails a booking over it.

# Email via Resend (https://resend.com → API Keys). RESEND_FROM must be an address on a
# domain you have verified with Resend (SPF + DKIM), e.g. "Invictus Golf <bookings@yourdomain.ca>".
RESEND_API_KEY=
RESEND_FROM=

# SMS via Twilio (https://console.twilio.com → Account Info). TWILIO_FROM is the sending
# number in E.164 format, e.g. +12045550123.
# CANADA: A2P 10DLC brand + campaign registration must be approved before Canadian carriers
# will deliver. That is days-to-weeks of paperwork — start it before you need the channel.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# INBOUND REPLIES (STOP / START / HELP) — api/waitlist.js ?action=sms-reply.
# Twilio stops the texts at the carrier level by itself, but only this webhook makes the DATABASE
# agree: it clears customers.sms_consent and stamps sms_unsub_at, so nothing is ever queued for
# someone who said stop. Paste this into the Twilio console, under
#   Phone Numbers -> Manage -> Active numbers -> <your number> -> Messaging -> "A message comes in"
# as Webhook + HTTP POST:
#   https://<your-app>/api/waitlist?action=sms-reply
# (locally: http://localhost:4242/api/waitlist?action=sms-reply, exposed with a tunnel.)
# The endpoint is public, so every request must carry a valid X-Twilio-Signature — it is verified
# with TWILIO_AUTH_TOKEN above, and without that token set the endpoint refuses everything.
# TWILIO_INBOUND_URL: only needed when the URL Twilio calls is not the URL this app sees (a proxy
# or rewrite in front of it). The signature covers the URL, so it must match to the character.
TWILIO_INBOUND_URL=

# CASL identification, used when there is no database to read settings.venue from. Every message
# must carry the venue's name and PHYSICAL MAILING ADDRESS, plus a working unsubscribe mechanism;
# nothing is sent until they are set (in settings.venue — see migration 0019 — or here).
NOTIFY_VENUE_NAME=
NOTIFY_VENUE_ADDRESS=
# Optional: the page that processes unsubscribe links. Leave blank and the venue's email address
# from settings.venue is offered as the unsubscribe mechanism instead (CASL accepts either).
NOTIFY_UNSUBSCRIBE_URL=


# ── Waiting list (see migration 0022 + api/waitlist.js) ────────────────────
# The shared secret pg_cron/pg_net (or any external scheduler) sends as the header
# "x-waitlist-secret" when it POSTs /api/waitlist?action=sweep. Without it the sweep endpoint
# refuses to run rather than letting a stranger make someone's phone ring. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# Then schedule the tick once, in Supabase → SQL Editor:
#   select public.waitlist_schedule_sweep('https://<your-app>/api/waitlist?action=sweep', '<the secret>');
WAITLIST_SWEEP_SECRET=

# ── Notification outbox drain (see api/waitlist.js ?action=outbox) ────────
# The shared secret pg_cron/pg_net (or any external scheduler) sends as the header
# "x-outbox-secret" when it POSTs /api/waitlist?action=outbox. That endpoint is what actually
# delivers queued email/SMS — booking receipts included — so without a secret it refuses to run
# rather than letting a stranger drive the messaging queue. Falls back to WAITLIST_SWEEP_SECRET
# if unset, so one scheduler secret can drive every cron job. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# Then schedule the tick once, in Supabase → SQL Editor:
#   select cron.schedule('outbox-sweep', '*/2 * * * *', $$
#     select net.http_post(
#       url := 'https://<your-app>/api/waitlist?action=outbox',
#       headers := '{"Content-Type":"application/json","x-outbox-secret":"<the secret>"}'::jsonb,
#       body := '{}'::jsonb,
#       timeout_milliseconds := 8000)
#   $$);
# Stop it again with:  select cron.unschedule('outbox-sweep');
OUTBOX_SWEEP_SECRET=

# Absolute base URL for the links inside notifications (claim links, unsubscribe pages). Optional:
# without it the app uses the origin of the incoming request, which is right in most deployments
# but wrong for a message sent from a cron job hitting an internal hostname.
PUBLIC_BASE_URL=

# ── Group + recurring bookings (migration 0023) ──
# How far ahead a recurring series is written into the bookings table. Occurrences are
# materialised, not computed on demand, because the gist exclusion constraint on `bookings` is the
# only thing that stops a bay being sold twice and a virtual occurrence cannot take part in it.
# Optional; 90 days if unset.
SERIES_HORIZON_DAYS=90

# The shared secret an external scheduler sends as "x-series-secret" when it POSTs
# /api/booking-series?action=extend to push that horizon forward. Falls back to
# WAITLIST_SWEEP_SECRET if unset, so one scheduler secret can drive both jobs. With neither set the
# endpoint refuses to run unauthenticated — it writes bookings.
SERIES_SWEEP_SECRET=


# LOCAL DEV ONLY. When set, /account on localhost skips sign-in and always opens the customer
# with this phone number, listing every booking made with it (any formatting). The route lives
# only in server.js, which Vercel never runs, so the deployed site is unaffected. Leave blank
# for the normal sign-in.
DEV_ACCOUNT_PHONE=
DEV_ACCOUNT_NAME=

# LOCAL DEV ONLY. The manager portal on localhost signs itself in as a real staff member instead of
# asking for a password (/api/dev/staff-session in server.js, which Vercel never runs, and which
# only answers requests from this machine). Leave blank to use the first active admin in the staff
# table; set an email to open the portal as that person instead — useful for checking what an
# employee or a read-only account can see. Add ?login=1 to the URL for the normal sign-in screen.
DEV_STAFF_EMAIL=
